# Production values for `npm run build` (Vite loads .env.production
# automatically in production mode, on top of .env — see
# docs/DEPLOYMENT.md). Copy this to `.env.production` (git-ignored, not
# committed) and fill in your real domains before building for deploy.
#
# These get baked into the built JS at build time — there's no server here
# to read them at runtime, unlike the backend's .env — so the site must be
# rebuilt and re-uploaded any time either of these changes.

# Your Laravel API's real URL, on whatever subdomain you pointed at
# backend/public (see docs/DEPLOYMENT.md) — must end in /api.
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Your site's real public URL (used for canonical links, Open Graph tags,
# and JSON-LD — see hooks/useSeo.js) — no trailing slash.
VITE_SITE_URL=https://www.yourdomain.com
