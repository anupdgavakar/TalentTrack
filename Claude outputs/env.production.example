# Production template for GoDaddy Web Hosting (cPanel) — see
# docs/DEPLOYMENT.md for the full step-by-step guide this pairs with.
# Copy this to `.env` on the server (NOT into git — `.env`/`.env.production`
# are already git-ignored) and fill in every placeholder below.
#
# This is deliberately a full copy of .env.example with production-correct
# values, not a diff — so there's one file to fill in and upload, not two
# to reconcile.

APP_NAME="Talent Track Technologies"
APP_ENV=production
# Generate on the server after upload with: php artisan key:generate
# (or generate locally with the same command and paste the result here —
# either way, this must be a real generated key, never left blank or
# copied from another environment).
APP_KEY=
# MUST be false in production — see the same note in .env.example for why.
APP_DEBUG=false
# Your API subdomain's real URL (see docs/DEPLOYMENT.md step 3) — https,
# no trailing slash.
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# "stack" -> "single" keeps everything in one storage/logs/laravel.log
# file, same as dev. LOG_LEVEL=error (not "debug") so production logs
# aren't flooded with routine debug-level noise — errors and warnings
# still get logged either way.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# From cPanel's "MySQL Databases" tool (docs/DEPLOYMENT.md step 2) — note
# GoDaddy/cPanel prefixes both the database name and username with your
# cPanel account username plus an underscore (e.g. a database you name
# "talenttrack" becomes "youraccountuser_talenttrack") — use the full
# prefixed names cPanel actually shows you, not what you typed into the
# "add database" field.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=youraccountuser_talenttrack
DB_USERNAME=youraccountuser_talenttrack
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave `null` unless the API and frontend need to share a cookie across
# a common parent domain, which this setup doesn't need — Sanctum's SPA
# auth here works via CORS + credentials, not a shared session-cookie
# domain (see SANCTUM_STATEFUL_DOMAINS below).
SESSION_DOMAIN=null
# MUST be true once served over https (which it will be — GoDaddy issues
# free SSL by default, see docs/DEPLOYMENT.md step 8). A cookie without
# this flag is readable over an unencrypted connection.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Stays "database" even in production — Phase 11's admin notification
# email is deliberately sent synchronously (see its own docblock,
# App\Mail\AdminNotification.php), and nothing else in this app queues
# anything, so there's no `php artisan queue:work` worker to run — which
# is good, because GoDaddy shared hosting doesn't support long-running
# background processes anyway.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Not used — this app doesn't use Memcached or Redis (CACHE_STORE and
# SESSION_DRIVER above are both "database"). Left blank/default rather
# than deleted, matching .env.example, in case a future phase needs them.
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Get real SMTP credentials from cPanel's "Email Accounts" tool (create a
# mailbox like notifications@yourdomain.com, then use its "Connect Devices"
# page for the exact host/port GoDaddy gives you — this varies enough by
# account that it's not worth guessing here) OR use a third-party
# transactional provider (Mailgun/SendGrid/Postmark/SES) instead, which is
# worth doing if deliverability to Gmail/Outlook inboxes matters — shared
# hosting IPs generally have weaker sender reputation than a dedicated
# transactional provider's. Either way: GoDaddy's Web Hosting (cPanel)
# plans cap outbound relay at 500 emails/day (500/hour account-wide) as of
# this writing — almost certainly fine for this app's volume (one email
# per new lead/enrollment/application), but worth knowing if it ever isn't.
MAIL_MAILER=smtp
# Left null: Laravel/Symfony Mailer defaults to plain "smtp" and upgrades
# to TLS via STARTTLS automatically when the server offers it, which is
# what port 587 below expects. If your mailbox's settings page instead
# gives you port 465, switch this to MAIL_SCHEME=smtps (465 is "implicit
# TLS from the first byte," a different handshake than STARTTLS — the two
# aren't interchangeable with the same scheme).
MAIL_SCHEME=null
# Replace with the exact host cPanel's Email Accounts -> "Connect Devices"
# page shows for the mailbox you create — commonly something under
# secureserver.net for GoDaddy-hosted mailboxes, but confirm it there
# rather than assuming, since the exact value can differ by account.
MAIL_HOST=REPLACE_WITH_YOUR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=notifications@yourdomain.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="notifications@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Who gets emailed about new leads/enrollments/applications (Phase 11) —
# comma-separated for multiple. This is only the fallback the admin
# Settings screen (/admin/settings) falls back to if nothing's been saved
# there yet; whoever deploys this can also just set it from the UI instead.
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Only needed if a future phase adds S3-compatible file storage —
# everything today uses FILESYSTEM_DISK=local (uploaded files live in
# storage/app/public on the server itself). Leave blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Your real frontend domain — https, no trailing slash, no path, and
# exactly ONE URL (unlike SANCTUM_STATEFUL_DOMAINS below, this value is
# used as-is, not split on commas — it's both the single CORS-allowed
# origin, config/cors.php, AND the link base for Phase 11's
# admin-notification emails and the sitemap, config('app.frontend_url')
# in SitemapController/JobApplicationController/etc. — a comma-separated
# value here would corrupt those links, not just allow multiple origins).
# Pick whichever of www.yourdomain.com / yourdomain.com you want as the
# canonical address and set your DNS/cPanel to redirect the other one to
# it (docs/DEPLOYMENT.md step 9) — then only the canonical form ever needs
# to be an allowed CORS origin.
FRONTEND_URL=https://www.yourdomain.com
# Same canonical domain as FRONTEND_URL, but as a bare host[:port] (no
# scheme). Unlike FRONTEND_URL this one IS comma-separated if you genuinely
# need Sanctum to treat more than one host as first-party — but with the
# www/non-www redirect above, one host is normally enough.
SANCTUM_STATEFUL_DOMAINS=www.yourdomain.com
