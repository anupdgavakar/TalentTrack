APP_NAME="Talent Track Technologies"
APP_ENV=local
APP_KEY=
# Fine to leave true for local dev (shows full stack traces in error
# responses, which is what makes debugging fast) — but this MUST be false
# in production. A debug-mode 500 response leaks file paths, env values,
# and query bindings to whoever triggered the error; see docs/PHASE_PLAN.md's
# Phase 13 section for the rest of the pre-deployment security checklist.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the target database for this project (see docs/ARCHITECTURE.md).
# SQLite can be used for quick local smoke-testing: set DB_CONNECTION=sqlite
# and create an empty database/database.sqlite file.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talenttrack
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# false is correct for local dev over plain http — the browser would
# silently refuse to store a Secure-flagged cookie at all otherwise, which
# would break login. Set this to true once the site is served over https
# (production), so the session cookie can't be read over an unencrypted
# connection.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log is fine for local dev (emails are written to the log
# instead of sent). Phase 11 configures a real transactional provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@talenttracktech.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin email(s) that receive new-lead / new-application notifications
# (Phase 11). Comma-separated for multiple recipients.
ADMIN_NOTIFICATION_EMAIL=admin@talenttracktech.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# React (Vite) frontend origin(s) — used for CORS and Laravel Sanctum's
# stateful-domain SPA authentication, wired up in Phase 3/4.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
