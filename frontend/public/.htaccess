# Apache rewrite rules for the React Router SPA (Phase 14 — GoDaddy Linux
# Hosting/cPanel uses Apache, not Nginx). Without this, a direct visit or
# refresh on any route other than "/" (e.g. /training, /admin/dashboard, a
# shared link to /training/some-course) 404s at the server, because there
# is no real file or folder at that path — only client-side React Router
# knows how to render it, and only after index.html has actually loaded
# and its JavaScript has run.
#
# This rewrites every request that ISN'T an existing real file or
# directory (so actual assets — JS/CSS/images/robots.txt — are still
# served normally) back to index.html, letting React Router take over
# and render the right page from the URL.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request is for a real file or directory, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise, hand it to index.html.
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed build assets (dist/assets/*, filenames include a content
# hash, so a new deploy always gets new filenames — safe to cache
# aggressively) for a year; leave index.html itself uncached so a redeploy
# is picked up on the next visit instead of serving a stale shell that
# references assets from a previous build that no longer exist.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
